# Client (public) settings, baked in at build time. Leave the Supabase pair empty
# to ship the game with no accounts and unlimited free play.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# 'subscription' (default): a paid Covenant unlocks unlimited runs.
# 'login': any signed-in account does.
VITE_GATE=subscription
# Free non-daily runs per day (the Daily Descent is always free).
VITE_FREE_RUNS=3
# Set to 1 once Google is enabled in Supabase → Authentication → Providers.
VITE_AUTH_GOOGLE=0
# Development only: fake accounts stored in the browser, no backend needed.
VITE_ACCOUNTS_MOCK=0

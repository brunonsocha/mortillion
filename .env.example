# Client (public) settings, baked in at build time.
# Leave the Supabase pair empty for a local build: content bundled, no accounts,
# unlimited free play. Fill them in for the remote build (game server, accounts,
# leaderboards, payments); answer banks are then left out of the bundle.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Labels on the purchase buttons (the real price lives in Stripe).
VITE_PRICE_PLN=19,99 zł
VITE_PRICE_EUR=5 €
# 'one-time' (default) for a lifetime full version; 'subscription' if the Price recurs.
VITE_PURCHASE=one-time
# Shown when the server's limit is reached; keep in step with FREE_RUNS_PER_DAY.
VITE_FREE_RUNS=3
# Set to 0 to hide the Google button.
VITE_AUTH_GOOGLE=1
# Development only: fake accounts stored in the browser, local content.
VITE_ACCOUNTS_MOCK=0
